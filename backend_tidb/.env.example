TIDB_HOST=your-tidb-host
TIDB_PORT=4000
TIDB_USER=your-tidb-user
TIDB_PASSWORD=your-tidb-password
TIDB_DATABASE=RoutineTrack
TIDB_SSL_CA=path/to/ca.pem
TIDB_SSL_CA_CONTENT=
